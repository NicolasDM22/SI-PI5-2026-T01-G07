# URL da API backend (cattle-api)
# Troque pelo IP LAN da sua máquina para testar no dispositivo físico
# Como descobrir: Windows → ipconfig | macOS/Linux → ifconfig
# Exemplo: EXPO_PUBLIC_API_URL=http://192.168.0.145:8000
# Para Android Emulator: EXPO_PUBLIC_API_URL=http://10.0.2.2:8000
EXPO_PUBLIC_API_URL=http://localhost:8000
