# Destinatário dos alertas de contagem
ALERT_EMAIL=alerta@exemplo.com

# Remetente dos e-mails (padrão: SMTP_USER)
SMTP_FROM=seu_email@example.com

# Credenciais SMTP para envio de e-mail
# Opção 1: SendGrid (recomendado)
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_USER=apikey
SMTP_PASSWORD=SG.seu_api_key_aqui
SMTP_TLS=true

# Opção 2: Gmail (requer verificação em duas etapas + Senha de App)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=seu_email@gmail.com
# SMTP_PASSWORD=sua_senha_de_app
# SMTP_TLS=true

# Opção 3: Mailpit (teste local, sem autenticação)
# SMTP_HOST=localhost
# SMTP_PORT=1025
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_TLS=false
